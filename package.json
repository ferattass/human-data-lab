{
  "name": "human-data-lab",
  "version": "0.3.0",
  "description": "Gerçek insan metninin (Türkçe ı/İ, birleşik aksan, emoji, apostrof…) form → kaydet → okuma, arama, kimlik ve benzersiz ad yollarında bozulup bozulmadığını tarayıcıdan sınar.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "hdl": "bin/hdl.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test test/e2e-demo.test.mjs",
    "test:all": "node --test test/",
    "demo": "node demo-app/server.mjs",
    "assets": "node scripts/build-assets.mjs",
    "repro:round3": "node experiments/repro-round3.mjs"
  },
  "keywords": [
    "unicode",
    "i18n",
    "testing",
    "playwright",
    "turkish",
    "collation",
    "data-integrity"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
