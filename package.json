{
  "name": "human-data-lab",
  "version": "0.5.0",
  "description": "Checks that human text your app accepts survives the save → fresh re-read journey, in a real browser.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "hdl": "bin/hdl.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:unit": "node --test test/core.test.ts test/matrix.test.ts test/architecture.test.ts",
    "test:research": "node --test research/test/unit.test.mjs",
    "demo": "node bin/hdl.mjs demo",
    "demo:server": "node examples/profile-demo/server.ts",
    "test:browser": "node --test --test-concurrency=1 test/acceptance.test.ts test/playwright-integration.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test:package": "node --test test/package.test.ts"
  },
  "keywords": [
    "unicode",
    "i18n",
    "testing",
    "playwright",
    "turkish",
    "collation",
    "data-integrity"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/playwright/src/index.d.ts",
      "default": "./dist/packages/playwright/src/index.js"
    },
    "./playwright": {
      "types": "./dist/packages/playwright/src/index.d.ts",
      "default": "./dist/packages/playwright/src/index.js"
    },
    "./playwright/test": {
      "types": "./dist/packages/playwright/src/test.d.ts",
      "default": "./dist/packages/playwright/src/test.js"
    },
    "./core": {
      "types": "./dist/packages/core/src/index.d.ts",
      "default": "./dist/packages/core/src/index.js"
    },
    "./corpus": {
      "types": "./dist/packages/corpus/src/index.d.ts",
      "default": "./dist/packages/corpus/src/index.js"
    },
    "./store": {
      "types": "./dist/packages/store/src/index.d.ts",
      "default": "./dist/packages/store/src/index.js"
    },
    "./reporter": {
      "types": "./dist/packages/reporter/src/index.d.ts",
      "default": "./dist/packages/reporter/src/index.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/packages/playwright/src/index.d.ts",
  "peerDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferattass/human-data-lab.git"
  },
  "homepage": "https://github.com/ferattass/human-data-lab#readme",
  "bugs": {
    "url": "https://github.com/ferattass/human-data-lab/issues"
  }
}
