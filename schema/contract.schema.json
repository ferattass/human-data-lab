{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferattass/human-data-lab/schema/contract.schema.json",
  "title": "FlowContract",
  "description": "Akış sözleşmesi / policy (§13). Beklentiyi uygulama sahibi açıkça seçer; araç tahmin etmez.",
  "type": "object",
  "required": ["schemaVersion", "id", "field", "inputMethod", "expectations", "preservation", "readback"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^0\\.\\d+$" },
    "id": { "type": "string", "minLength": 1 },
    "field": {
      "type": "object",
      "required": ["id", "control"],
      "properties": { "id": { "type": "string" }, "control": { "enum": ["input-text", "textarea"] } }
    },
    "inputMethod": { "const": "fill" },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "description": "İlk eşleşen bağlanır; eşleşmeyen fixture kapsam dışıdır",
      "items": {
        "type": "object",
        "required": ["properties", "expect"],
        "properties": {
          "properties": { "oneOf": [{ "const": "*" }, { "type": "array", "items": { "type": "string" } }] },
          "expect": { "enum": ["must-accept", "must-reject"] }
        }
      }
    },
    "fixtureExpectations": { "type": "object", "additionalProperties": { "enum": ["must-accept", "must-reject"] } },
    "preservation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "required", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "rule": { "enum": ["text.exact.v1", "text.nfc.v1"], "description": "Kapalı set; bilinmeyen kural preflight hatasıdır (A14)" },
          "required": { "type": "boolean", "description": "Yalnız required kontroller CI sonucunu etkiler" },
          "boundary": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "enum": ["authored", "injected", "submitted", "readback"] },
            "description": "Sıralı: authored < injected < submitted < readback"
          }
        }
      }
    },
    "readback": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "first-independent-read" } } },
        {
          "type": "object", "required": ["kind", "consecutive", "intervalMs", "budgetMs"],
          "properties": { "kind": { "const": "stable-read" }, "consecutive": { "type": "integer", "minimum": 2 }, "intervalMs": { "type": "integer", "minimum": 0 }, "budgetMs": { "type": "integer", "minimum": 1 } }
        },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "readiness-signal" } } }
      ]
    }
  }
}
