{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferattass/human-data-lab/schema/corpus.schema.json",
  "title": "Corpus",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "description", "fixtures"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^0\\.\\d+$" },
    "id": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "İçerik değişirse artar; digest de değişir" },
    "description": { "type": "string" },
    "sets": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "fixtures": { "type": "array", "minItems": 1, "items": { "$ref": "fixture.schema.json" } }
  }
}
